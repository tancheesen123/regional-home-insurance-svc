# ── Inference backend — set USE_GROQ=true for Groq cloud, false for local Ollama
USE_GROQ=false

# ── Groq (cloud) — fast, free tier at https://console.groq.com ───────────────
GROQ_API_KEY=gsk_...
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── Ollama (local) ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=llama3.2-vision:11b

# ── File limits ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=3

# ── Auth — must match JwtSettings in ApplicationService appsettings.json ──────
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_AUDIENCE=ApplicationServiceClients
JWT_ISSUER=ApplicationService

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
