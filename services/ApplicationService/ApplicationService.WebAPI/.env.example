# =============================================================
#  Regional Home Insurance — environment variable template
#  Copy this file to .env and fill in your local values.
#  Never put real credentials in this file.
# =============================================================

# ── Database connection strings ───────────────────────────────
ConnectionStrings__DefaultConnection=Server=YOUR_SERVER;Database=ApplicationServiceDb;Integrated Security=True;TrustServerCertificate=True
ConnectionStrings__PHUnityDb=Server=YOUR_SERVER;Database=PHUnityDb;Integrated Security=True;TrustServerCertificate=True
ConnectionStrings__IDUnityDb=Server=YOUR_SERVER;Database=IDUnityDb;Integrated Security=True;TrustServerCertificate=True
ConnectionStrings__KHUnityDb=Server=YOUR_SERVER;Database=KHUnityDb;Integrated Security=True;TrustServerCertificate=True

# ── JWT ───────────────────────────────────────────────────────
# Must be at least 32 characters
JwtSettings__Secret=YOUR_JWT_SECRET_AT_LEAST_32_CHARS

# ── Email (SMTP) ──────────────────────────────────────────────
EmailSettings__Username=your-email@gmail.com
EmailSettings__Password=your-app-password

# ── Stripe ────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
StripeSettings__SecretKey=sk_test_...
StripeSettings__PublishableKey=pk_test_...
# Get from Stripe Dashboard > Webhooks > your endpoint > Signing secret
StripeSettings__WebhookSecret=whsec_...
