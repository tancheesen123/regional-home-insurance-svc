<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="DinkToPdf" Version="1.0.8" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.22" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApplicationService.Core.Application\ApplicationService.Core.Application.csproj" />
    <ProjectReference Include="..\ApplicationService.Infrastructure.Shared\ApplicationService.Infrastructure.Shared.csproj" />
    <ProjectReference Include="..\ApplicationService.Infrastructure.Persistence\ApplicationService.Infrastructure.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\IDN\" />
    <Folder Include="Controllers\KHM\" />
    <Folder Include="Controllers\PHL\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy all XSL, email, SMS templates and images to output so the app can read them at runtime -->
    <Content Include="Docs\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      DinkToPdf native library — copy to output alongside the executable.
      HOW TO GET THE FILE (Windows):
        1. Download: https://wkhtmltopdf.org/downloads.html
           → wkhtmltox-0.12.6-1.msvc2015-win64.exe
        2. Install it (default: C:\Program Files\wkhtmltopdf\)
        3. Copy  C:\Program Files\wkhtmltopdf\bin\wkhtmltox.dll
           into this project directory (same folder as this .csproj).
           NOTE: the installer ships it as "wkhtmltox.dll" (no lib prefix) — that is fine.
               Program.cs uses NativeLibrary.SetDllImportResolver to map
               "libwkhtmltox" → "wkhtmltox.dll" automatically.
      LINUX:
        apt-get install libwkhtmltox  — ships as libwkhtmltox.so
    -->
    <!-- Windows installer name (no lib prefix) -->
    <Content Include="wkhtmltox.dll" Condition="Exists('wkhtmltox.dll')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- Alternative: manually renamed to lib prefix -->
    <Content Include="libwkhtmltox.dll" Condition="Exists('libwkhtmltox.dll')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- Linux -->
    <Content Include="libwkhtmltox.so" Condition="Exists('libwkhtmltox.so')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!--
      Transitive shared-library dependencies of libwkhtmltox.so
      (libjpeg, libpng, fontconfig, freetype, X11, etc.) that are not
      present in the Azure App Service Linux dotnet runtime image.
      Copied to native-libs/ alongside the app; LD_LIBRARY_PATH must
      include this folder (set via app setting:
        LD_LIBRARY_PATH=/home/site/wwwroot/native-libs )
      so the dynamic linker can resolve them when loading libwkhtmltox.so.
    -->
    <Content Include="native-libs\**" Condition="Exists('native-libs')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
